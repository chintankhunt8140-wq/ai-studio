# ==============================================================================
# AI Studio - Environment Variables Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY SECRETS (Never expose to client/browser, accessed via process.env)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Google GenAI (Gemini Image models & Veo Video synthesis).
# The platform injects this automatically at runtime from user secrets.
# NEVER prefix with VITE_ or access from client-side code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. PUBLIC / CLIENT-SAFE CONFIGURATION (Optional, non-sensitive runtime parameters)
# ------------------------------------------------------------------------------
# APP_URL: The URL where this applet is hosted on Cloud Run.
APP_URL="MY_APP_URL"
