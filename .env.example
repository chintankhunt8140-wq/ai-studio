# ==============================================================================
# AI Studio Creative Engine - Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED CONFIGURATION (Production & Development)
# ------------------------------------------------------------------------------

# GEMINI_API_KEY (Required)
# Server-only secret used for Google GenAI SDK (Gemini Image models & Veo Video synthesis).
# The platform injects this automatically from AI Studio project settings.
# For self-hosted deployments, obtain a key from https://aistudio.google.com/
# Security rule: NEVER expose to the client browser or prefix with VITE_.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. OPTIONAL PRODUCTION PARAMETERS
# ------------------------------------------------------------------------------

# NODE_ENV (Optional, defaults to 'development' in local dev)
# Set to 'production' for live deployment containers to enable optimized static serving.
NODE_ENV=production

# PORT (Optional, hardcoded to 3000 in AI Studio container proxy)
# Specifies the HTTP server port to bind.
PORT=3000

# APP_URL (Optional)
# Canonical origin or public URL of the deployed application.
APP_URL=

# STORAGE_ADAPTER (Optional, defaults to 'local')
# Storage backend used for persisting reference uploads and generated media.
# Supported options: 'local' (filesystem /public/assets).
# For distributed multi-instance production (e.g., Cloud Run multi-replica), configure Google Cloud Storage.
STORAGE_ADAPTER=local

# DATABASE_ADAPTER (Optional, defaults to 'json')
# Persistence backend for jobs, creations, users, and audit logs.
# Current options: 'json' (persistent atomic store.json).
# For clustered production environments, set up a durable cloud database (e.g. Firestore / Cloud SQL).
DATABASE_ADAPTER=json

# ------------------------------------------------------------------------------
# 3. DEVELOPMENT ONLY
# ------------------------------------------------------------------------------

# VITE_LOG_LEVEL (Optional, development debugging)
# Controls Vite's logging verbosity: 'info' | 'warn' | 'error' | 'silent'.
VITE_LOG_LEVEL=info
